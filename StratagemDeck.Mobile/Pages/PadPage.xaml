<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StratagemDeck.Mobile.ViewModels"
             xmlns:controls="clr-namespace:StratagemDeck.Mobile.Controls"
             x:Class="StratagemDeck.Mobile.Pages.PadPage"
             x:DataType="vm:GameViewModel"
             Title="Pad"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Canvas}">

    <controls:InputPadView x:Name="Pad"
                           CtrlEnabled="{Binding CtrlEnabled, Mode=TwoWay}"
                           IsConnected="{Binding IsConnected}"
                           InputStatus="{Binding InputStatus}"
                           LastInput="{Binding LastInput}"
                           KeyDownCommand="{Binding KeyDownCommand}"
                           KeyUpCommand="{Binding KeyUpCommand}"
                           ToggleCtrlCommand="{Binding ToggleCtrlCommand}" />

</ContentPage>
